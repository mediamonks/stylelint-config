{
  "name": "@mediamonks/stylelint-config",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "provenance": true
  },
  "scripts": {
    "stylelint": "npm run stylelint --workspaces --if-present",
    "stylelint:fix": "npm run stylelint:fix --workspaces --if-present",
    "prepare": "husky"
  },
  "devDependencies": {
    "@mediamonks/eslint-config": "^3.1.1",
    "@mediamonks/prettier-config": "^1.0.1",
    "eslint": "^9.38.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "prettier": "@mediamonks/prettier-config",
  "lint-staged": {
    "*.{js,jsx,scss,css,md,json}": "prettier --write",
    "*.{js,jsx}": "eslint --fix"
  },
  "eslintConfig": {
    "extends": "@mediamonks/eslint-config",
    "env": {
      "node": true,
      "browser": true
    },
    "parserOptions": {
      "ecmaVersion": "latest"
    }
  }
}
